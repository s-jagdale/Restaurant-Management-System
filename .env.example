# Server Port (default 3000)
PORT=3000

# MongoDB Connection String (Atlas or Local MongoDB)
# For Render / Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/restaurant_db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurant_db

# Tax percentage added to bills (e.g. 5 for 5% GST)
TAX_RATE=5

# Secret key used for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Node environment
NODE_ENV=production

# Initial Administrator Credentials (seeded on first run)
ADMIN_EMAIL=jagdalesanika1234@gmail.com
ADMIN_PASSWORD=admin123
